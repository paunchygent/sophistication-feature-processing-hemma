#!/usr/bin/env bash
# No shell fragments in .desktop Exec fields. No credential or private-home reads.
set -euo pipefail
SUPPORT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ROOT=${WORKSHOP_ROOT:-/config/workspace}
HOME_ROOT=${WORKSHOP_HOME:-/config}
PYTHON=${WORKSHOP_PYTHON:-/opt/taaled-venv/bin/python}
case "${1:-}" in
  start) exec xdg-open "$SUPPORT/docs/START-HERE.txt" ;;
  files) exec pcmanfm-qt "${FEATURE_BROWSE_ROOT:-/hemma-home}" ;;
  data) exec pcmanfm-qt "$HOME_ROOT/Navigation" ;;
  output) exec pcmanfm-qt "$ROOT/output" ;;
  terminal) cd "${FEATURE_BROWSE_ROOT:-/hemma-home}"; exec xterm ;;
  taaled) exec "$PYTHON" "$SUPPORT/app/taaled/workshop_gui.py" ;;
  taales) exec "$PYTHON" "$SUPPORT/app/taaled/workshop_taales.py" ;;
  jasp) exec "$PYTHON" "$SUPPORT/app/jasp_client.py" ;;
  suite) exec "$PYTHON" "$SUPPORT/app/suite_launcher.py" ;;
  *) printf 'Usage: %s {start|files|data|output|terminal|taaled|taales|jasp|suite}\n' "$0" >&2; exit 64 ;;
esac
